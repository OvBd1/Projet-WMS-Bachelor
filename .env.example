# Variables lues par docker compose. Copier vers .env et adapter :
#   cp .env.example .env

# Port d'accès à l'application (http://localhost:HTTP_PORT)
HTTP_PORT=8080

# Environnement Symfony (prod par défaut ; le mode dev est forcé par l'override)
APP_ENV=prod
APP_DEBUG=0
# Générer : php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=change_me

# Base de données MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=wms
MYSQL_USER=wms
MYSQL_PASSWORD=wms

# CORS
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# JWT (Lexik) — passphrase pour les clés RS256
JWT_PASSPHRASE=change_me
