# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Base de test : doctrine.yaml ajoute le suffixe « _test » (wms → wms_test).
# Surcharger par variable d'environnement selon le contexte (ex. Docker : hôte « db »).
DATABASE_URL="mysql://root:root@127.0.0.1:3306/wms?serverVersion=8.0&charset=utf8mb4"

# Aucun appel externe pendant les tests : adresse injoignable et délai court,
# ce qui exerce la dégradation silencieuse de la passerelle adresse.
ADRESSE_API_BASE_URL=http://127.0.0.1:9
ADRESSE_API_TIMEOUT=0.5
